{
  "id": "azure-commercial-development",
  "displayName": "Azure Commercial Development",
  "cloud": "AzureCommercial",
  "tenantId": "00000000-0000-0000-0000-000000000000",
  "subscriptionId": "00000000-0000-0000-0000-000000000000",
  "managementGroupId": "00000000-0000-0000-0000-000000000000",
  "defaultLocation": "eastus",
  "allowedLocations": ["eastus", "eastus2"],
  "resourceGroupStrategy": {
    "mode": "CreatePerWorkload",
    "namePattern": "rg-amw-{workload}-{environment}-{location}",
    "tagsInherited": true
  },
  "networkIntegration": {
    "vnetStrategy": "Required",
    "privateEndpointRequiredPatterns": ["storage-account", "key-vault"],
    "approvedSubnetResourceIds": [
      "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-network/providers/Microsoft.Network/virtualNetworks/vnet-platform/subnets/snet-appsvc-dev",
      "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-network/providers/Microsoft.Network/virtualNetworks/vnet-platform/subnets/snet-private-endpoints"
    ]
  },
  "privateDnsConfiguration": {
    "enabled": true,
    "zoneResourceIds": [
      "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-network/providers/Microsoft.Network/privateDnsZones/privatelink.azurewebsites.net",
      "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-network/providers/Microsoft.Network/privateDnsZones/privatelink.blob.core.windows.net",
      "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-network/providers/Microsoft.Network/privateDnsZones/privatelink.vaultcore.azure.net"
    ]
  },
  "logAnalyticsWorkspaceResourceId": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-observability/providers/Microsoft.OperationalInsights/workspaces/law-platform-dev",
  "policyAssignmentScope": "/providers/Microsoft.Management/managementGroups/00000000-0000-0000-0000-000000000000",
  "approvedModuleRegistry": {
    "alias": "missionworkspace",
    "registry": "missionworkspace.azurecr.io",
    "modulePath": "bicep/modules"
  },
  "requiredTags": ["costCenter", "owner", "environment", "dataClassification"],
  "allowedServicePatterns": ["internal-web-api", "internal-web-app", "storage-account", "key-vault"],
  "approvalPolicy": {
    "productionApprovers": 2,
    "changeWindowRequired": false,
    "maxValidationAgeHours": 24
  },
  "deploymentIdentityReference": {
    "type": "FederatedServiceConnection",
    "value": "azdo-sc-amw-commercial-dev"
  }
}
