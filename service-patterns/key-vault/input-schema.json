{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/service-pattern-inputs/key-vault.json",
  "title": "Key Vault Inputs",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workloadName",
    "location",
    "environment",
    "costCenter",
    "owner",
    "dataClassification",
    "logAnalyticsWorkspaceResourceId",
    "tenantId",
    "subnetResourceId"
  ],
  "properties": {
    "workloadName": { "type": "string", "pattern": "^[a-z0-9-]{3,24}$" },
    "location": { "type": "string", "enum": ["eastus", "eastus2", "centralus", "usgovvirginia"] },
    "environment": { "type": "string", "enum": ["dev", "test", "stg", "prod"] },
    "costCenter": { "type": "string", "minLength": 2, "maxLength": 32 },
    "dataClassification": { "type": "string", "enum": ["Public", "Internal", "Confidential", "HighlyConfidential"] },
    "tenantId": { "type": "string", "pattern": "^[0-9a-fA-F-]{36}$" },
    "subnetResourceId": { "type": "string", "pattern": "^/subscriptions/.+/subnets/.+$" },
    "softDeleteRetentionInDays": { "type": "integer", "minimum": 7, "maximum": 90, "default": 90 },
    "purgeProtectionEnabled": { "type": "boolean", "default": true },
    "keyVaultSku": { "type": "string", "default": "standard", "enum": ["standard", "premium"] },
    "allowedObjectIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-fA-F-]{36}$"
      },
      "default": []
    },
    "bootstrapSecretIdentifier": { "type": "string", "pattern": "^https://.+/secrets/.+$" }
  }
}
