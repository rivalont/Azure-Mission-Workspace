{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/service-pattern-inputs/storage-account.json",
  "title": "Storage Account Inputs",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workloadName",
    "location",
    "environment",
    "costCenter",
    "owner",
    "dataClassification",
    "logAnalyticsWorkspaceResourceId",
    "replicationSku",
    "subnetResourceIds"
  ],
  "properties": {
    "workloadName": { "type": "string", "pattern": "^[a-z0-9-]{3,24}$" },
    "location": { "type": "string", "enum": ["eastus", "eastus2", "centralus", "usgovvirginia"] },
    "environment": { "type": "string", "enum": ["dev", "test", "stg", "prod"] },
    "costCenter": { "type": "string", "minLength": 2, "maxLength": 32 },
    "dataClassification": { "type": "string", "enum": ["Public", "Internal", "Confidential", "HighlyConfidential"] },
    "replicationSku": { "type": "string", "enum": ["Standard_LRS", "Standard_ZRS", "Standard_GRS", "Standard_RAGRS"] },
    "subnetResourceIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^/subscriptions/.+/subnets/.+$"
      }
    },
    "accountKind": { "type": "string", "default": "StorageV2", "enum": ["StorageV2", "BlockBlobStorage", "FileStorage"] },
    "accessTier": { "type": "string", "default": "Hot", "enum": ["Hot", "Cool"] },
    "allowBlobPublicAccess": { "type": "boolean", "default": false },
    "enableHierarchicalNamespace": { "type": "boolean", "default": false },
    "customerManagedKeySecretIdentifier": { "type": "string", "pattern": "^https://.+/secrets/.+$" }
  }
}
