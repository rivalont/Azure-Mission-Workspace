{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/service-pattern-inputs/internal-web-app.json",
  "title": "Internal Web App Inputs",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workloadName",
    "location",
    "environment",
    "costCenter",
    "owner",
    "dataClassification",
    "logAnalyticsWorkspaceResourceId",
    "subnetResourceId",
    "containerImage"
  ],
  "properties": {
    "workloadName": { "type": "string", "pattern": "^[a-z0-9-]{3,24}$" },
    "location": { "type": "string", "enum": ["eastus", "eastus2", "centralus", "usgovvirginia"] },
    "environment": { "type": "string", "enum": ["dev", "test", "stg", "prod"] },
    "costCenter": { "type": "string", "minLength": 2, "maxLength": 32 },
    "dataClassification": { "type": "string", "enum": ["Public", "Internal", "Confidential", "HighlyConfidential"] },
    "subnetResourceId": { "type": "string", "pattern": "^/subscriptions/.+/subnets/.+$" },
    "containerImage": { "type": "string", "minLength": 10 },
    "skuName": { "type": "string", "default": "P1v3", "enum": ["P1v3", "P2v3", "P3v3", "I1v2"] },
    "healthCheckPath": { "type": "string", "default": "/" },
    "minInstanceCount": { "type": "integer", "minimum": 1, "maximum": 10, "default": 1 },
    "appSettings": { "type": "object", "default": {}, "additionalProperties": { "type": "string" } },
    "startupCommand": { "type": "string" },
    "sessionSigningKeySecretIdentifier": { "type": "string", "pattern": "^https://.+/secrets/.+$" },
    "downstreamApiClientSecretIdentifier": { "type": "string", "pattern": "^https://.+/secrets/.+$" }
  }
}
