{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/environment-profile.schema.json",
  "title": "Environment Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "displayName",
    "cloud",
    "tenantId",
    "subscriptionId",
    "managementGroupId",
    "defaultLocation",
    "allowedLocations",
    "resourceGroupStrategy",
    "networkIntegration",
    "privateDnsConfiguration",
    "logAnalyticsWorkspaceResourceId",
    "policyAssignmentScope",
    "approvedModuleRegistry",
    "requiredTags",
    "allowedServicePatterns",
    "approvalPolicy",
    "deploymentIdentityReference"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "displayName": { "type": "string", "minLength": 3 },
    "cloud": { "type": "string", "enum": ["AzureCommercial", "AzureGovernment"] },
    "tenantId": { "type": "string", "pattern": "^[0-9a-fA-F-]{36}$" },
    "subscriptionId": { "type": "string", "pattern": "^[0-9a-fA-F-]{36}$" },
    "managementGroupId": { "type": "string", "pattern": "^[0-9a-fA-F-]{36}$" },
    "defaultLocation": { "type": "string", "minLength": 3 },
    "allowedLocations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 },
      "uniqueItems": true
    },
    "resourceGroupStrategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "namePattern", "tagsInherited"],
      "properties": {
        "mode": { "type": "string", "enum": ["ExistingOnly", "CreatePerDeployment", "CreatePerWorkload"] },
        "namePattern": { "type": "string", "minLength": 3 },
        "tagsInherited": { "type": "boolean" }
      }
    },
    "networkIntegration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vnetStrategy", "privateEndpointRequiredPatterns", "approvedSubnetResourceIds"],
      "properties": {
        "vnetStrategy": { "type": "string", "enum": ["Required", "Optional", "NotSupported"] },
        "privateEndpointRequiredPatterns": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "approvedSubnetResourceIds": {
          "type": "array",
          "items": { "type": "string", "pattern": "^/subscriptions/.+/subnets/.+$" },
          "uniqueItems": true
        }
      }
    },
    "privateDnsConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "zoneResourceIds"],
      "properties": {
        "enabled": { "type": "boolean" },
        "zoneResourceIds": {
          "type": "array",
          "items": { "type": "string", "pattern": "^/subscriptions/.+/privateDnsZones/.+$" },
          "uniqueItems": true
        }
      }
    },
    "logAnalyticsWorkspaceResourceId": { "type": "string", "pattern": "^/subscriptions/.+/providers/Microsoft[.]OperationalInsights/workspaces/.+$" },
    "policyAssignmentScope": { "type": "string", "pattern": "^/providers/Microsoft[.]Management/managementGroups/.+$|^/subscriptions/.+$" },
    "approvedModuleRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "registry", "modulePath"],
      "properties": {
        "alias": { "type": "string", "minLength": 1 },
        "registry": { "type": "string", "minLength": 1 },
        "modulePath": { "type": "string", "minLength": 1 }
      }
    },
    "requiredTags": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "allowedServicePatterns": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "uniqueItems": true
    },
    "approvalPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productionApprovers", "changeWindowRequired", "maxValidationAgeHours"],
      "properties": {
        "productionApprovers": { "type": "integer", "minimum": 1, "maximum": 10 },
        "changeWindowRequired": { "type": "boolean" },
        "maxValidationAgeHours": { "type": "integer", "minimum": 1, "maximum": 168 }
      }
    },
    "deploymentIdentityReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": { "type": "string", "enum": ["FederatedServiceConnection", "ManagedIdentity", "ServicePrincipalReference"] },
        "value": { "type": "string", "minLength": 3 }
      }
    }
  }
}
